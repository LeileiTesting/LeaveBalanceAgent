    <Schema Namespace="SFOData" xmlns="http://schemas.microsoft.com/ado/2008/09/edm" xmlns:sf="http://www.successfactors.com/edm/sf" xmlns:sap="http://www.sap.com/Protocols/SAPData">
      <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
        <EntitySet Name="AvailableTimeType" EntityType="SFOData.AvailableTimeType" sap:label="Available Time Type" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>AvailableTimeType</Summary><LongDescription>Contains information about the available time type, which is one of the time types that an employee is allowed to take. This information is assigned to an employee's job information.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="EmpTimeAccountBalance" EntityType="SFOData.EmpTimeAccountBalance" sap:label="EmpTimeAccountBalance" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>EmpTimeAccountBalance</Summary><LongDescription>Contains time account balance information which allows external systems like Payroll access to the data. You can use this information to enrich the employee's pay slip with time off data.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag><sap:tag>Results List Not Supported</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="EmployeeTime" EntityType="SFOData.EmployeeTime" sap:label="Employee Time" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>EmployeeTime</Summary><LongDescription>Contains information related to attendance times of hourly and salaried employees.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag><sap:tag>Recommended</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeAccount" EntityType="SFOData.TimeAccount" sap:label="TimeAccount" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>TimeAccount</Summary><LongDescription>This entity represents a Time Account for a specific user. A Time Account has a validity as well as a booking period and contains time account bookings.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeAccountDetail" EntityType="SFOData.TimeAccountDetail" sap:label="Time Account Detail" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>TimeAccountDetail</Summary><LongDescription>The entity describes account bookings resulting from different scenarios such as leave request creation or manual adjustments.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeAccountSnapshot" EntityType="SFOData.TimeAccountSnapshot" sap:label="Time Account Snapshot" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeAccountSnapshot</Summary><LongDescription>Contains balance information of a specific time account for a user</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeAccountType" EntityType="SFOData.TimeAccountType" sap:label="Time Account Type" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeAccountType</Summary><LongDescription>The entity is the template regulating what user-specific time accounts should look like.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeType" EntityType="SFOData.TimeType" sap:label="Time Type" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeType</Summary><LongDescription>Contains the time type definition.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet>
        <EntitySet Name="TimeTypeProfile" EntityType="SFOData.TimeTypeProfile" sap:label="Time Profile" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeTypeProfile</Summary><LongDescription>In a time profile, you specify which time types the employee is allowed to take. The time profile is part of an employee's job information.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag><sap:tag>EC - Payroll Time Sheets</sap:tag></sap:tagcollection></Documentation></EntitySet>
      </EntityContainer>
